[Unit]
Description=NAS Manager - interface web de gestion NAS
After=network-online.target zfs.target
Wants=network-online.target

[Service]
Type=simple
# Root est requis : zpool/parted/smartctl/systemctl/docker/samba nécessitent
# des privilèges administrateur. Ne jamais faire tourner ce service sous un
# utilisateur non privilégié tant que ces opérations passent par subprocess.
User=root
WorkingDirectory=/opt/nas-manager
EnvironmentFile=/opt/nas-manager/.env
# HTTPS avec le certificat auto-signe genere par install.sh (voir README -
# "Securite - HTTPS"). Le port 8443 (plutot que 443) evite tout conflit
# avec un service publie par une stack Docker sur le port standard.
ExecStart=/opt/nas-manager/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8443 --ssl-keyfile /etc/nas-manager/ssl/privkey.pem --ssl-certfile /etc/nas-manager/ssl/cert.pem
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
